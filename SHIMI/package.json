    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "bidi-js": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.147.0"
